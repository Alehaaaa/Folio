# Keep this repository focused on Folio source, build configuration and tests.
# Other workspace files include agent transcripts, personal attachments and logs.
/*
!/.gitignore
!/README.md
!/altstore.json
!/altstore/
!/app/
!/extensions/
!/checks/

# All generated builds, packaged applications, screenshots and diagnostics.
**/.DS_Store
**/.build/
**/.build*/
**/target/
**/DerivedData/
**/dist/
**/xcuserdata/
**/__pycache__/
**/*.pyc
**/*.log
**/*.ipa
**/*.xcarchive
**/*.dSYM/
**/*.xcactivitylog
**/*.xcuserstate
**/*.epub
**/*.mobi
**/*.pdf
**/*.sqlite
**/*.db
**/.env
**/.env.*
**/*.p12
**/*.mobileprovision
**/*.pem
**/*.key

/app/Folio.app/
/app/main
/app/shots/
/app/checks/*.png
/app/checks/*.html
/app/checks/anna-runtime-probe
/app/checks/diagnose-anna-browser
/app/checks/extension-browser-probe
/app/iOS/build*.log
/app/iOS/worker*.log
/checks/round-0/
/checks/anna-integration/folio.png
/checks/anna-free-webkit-trace
/checks/.anna-urlsession-*-probe
/checks/*-hang.sample.txt
